generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String?
  role               UserRole  @default(AUTHOR)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  sessionVersion     Int       @default(0)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  author             Author?

  @@index([role])
  @@index([isActive])
}

model Author {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  bio       String?
  imageUrl  String?
  userId    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
  user      User?     @relation(fields: [userId], references: [id])
}

model Category {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  imageUrl          String?
  sortOrder         Int               @default(0)
  parentId          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  articles          Article[]
  guides            BuyingGuide[]
  parent            Category?         @relation("CategoryChildren", fields: [parentId], references: [id])
  children          Category[]        @relation("CategoryChildren")
  products          Product[]
  productCategories ProductCategory[]
  subcategories     Subcategory[]

  @@index([parentId])
  @@index([sortOrder])
}

model Subcategory {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
  products  ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Article {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  subtitle          String?
  excerpt           String?
  featuredImage     String?
  status            ContentStatus     @default(DRAFT)
  categoryId        String
  authorId          String
  publishedAt       DateTime?
  scheduledAt       DateTime?
  updatedAt         DateTime          @updatedAt
  createdAt         DateTime          @default(now())
  clicks            AffiliateClick[]
  author            Author            @relation(fields: [authorId], references: [id])
  category          Category          @relation(fields: [categoryId], references: [id])
  blocks            ArticleBlock[]
  relatedProducts   ArticleProduct[]
  relatedArticles   ArticleRelation[] @relation("ArticleRelationsFrom")
  relatedToArticles ArticleRelation[] @relation("ArticleRelationsTo")
  tags              ArticleTag[]
  faqs              FAQ[]
  seo               SEOData?

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([authorId])
}

model ArticleBlock {
  id        String           @id @default(cuid())
  articleId String
  type      ArticleBlockType
  position  Int
  data      Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([articleId, position])
}

model FAQ {
  id        String  @id @default(cuid())
  articleId String
  question  String
  answer    String
  position  Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, position])
}

model ArticleRelation {
  articleId        String
  relatedArticleId String
  article          Article @relation("ArticleRelationsFrom", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle   Article @relation("ArticleRelationsTo", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@id([articleId, relatedArticleId])
  @@index([relatedArticleId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  websiteUrl  String?
  logoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String?
  editorialSummary String?
  brandId          String?
  categoryId       String
  status           ProductStatus     @default(DISCOVERED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clicks           AffiliateClick[]
  articleProducts  ArticleProduct[]
  comparisonItems  ComparisonItem[]
  brand            Brand?            @relation(fields: [brandId], references: [id])
  category         Category          @relation(fields: [categoryId], references: [id])
  categories       ProductCategory[]
  features         ProductFeature[]
  images           ProductImage[]
  tags             ProductTag[]
  variants         ProductVariant[]
  providerProducts ProviderProduct[]
  redirects        Redirect[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status])
}

model ProductCategory {
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductFeature {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id         String               @id @default(cuid())
  productId  String
  name       String
  sku        String?
  attributes Json?
  imageUrl   String?
  status     ProductVariantStatus @default(ACTIVE)
  position   Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([productId, sku])
  @@index([status])
}

model AffiliateProvider {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  status           ProviderStatus    @default(CONFIGURED)
  websiteUrl       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clicks           AffiliateClick[]
  providerProducts ProviderProduct[]
  redirects        Redirect[]
}

model ProviderProduct {
  id                String            @id @default(cuid())
  productId         String
  providerId        String
  externalProductId String
  productUrl        String?
  affiliateUrl      String?
  providerMetadata  Json?
  price             Decimal?          @db.Decimal(12, 2)
  currency          String?           @db.VarChar(3)
  availability      String?
  lastSyncedAt      DateTime?
  syncStatus        SyncStatus        @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  priority          Int               @default(100)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider          AffiliateProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalProductId])
  @@index([productId, providerId])
  @@index([productId, priority])
  @@index([syncStatus, lastSyncedAt])
}

model ArticleProduct {
  articleId String
  productId String
  position  Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
}

model Comparison {
  id          String           @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  guides      BuyingGuide[]
  items       ComparisonItem[]
}

model ComparisonItem {
  id           String     @id @default(cuid())
  comparisonId String
  productId    String
  bestFor      String?
  keyFeature   String?
  position     Int        @default(0)
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([comparisonId, position])
  @@index([productId])
}

model BuyingGuide {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  introduction  String?
  featuredImage String?
  status        ContentStatus @default(DRAFT)
  categoryId    String
  comparisonId  String?
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      Category      @relation(fields: [categoryId], references: [id])
  comparison    Comparison?   @relation(fields: [comparisonId], references: [id])
  blocks        GuideBlock[]
  faqs          GuideFAQ[]
  seo           SEOData?

  @@index([status, publishedAt])
  @@index([categoryId, status])
}

model GuideBlock {
  id       String           @id @default(cuid())
  guideId  String
  type     ArticleBlockType
  position Int
  data     Json
  guide    BuyingGuide      @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, position])
  @@index([guideId, position])
}

model GuideFAQ {
  id       String      @id @default(cuid())
  guideId  String
  question String
  answer   String
  position Int         @default(0)
  guide    BuyingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, position])
}

model SEOData {
  id            String       @id @default(cuid())
  title         String?
  description   String?
  canonicalUrl  String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  robotsIndex   Boolean      @default(true)
  robotsFollow  Boolean      @default(true)
  articleId     String?      @unique
  guideId       String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  article       Article?     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  guide         BuyingGuide? @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

model SeasonalCampaign {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  caption   String?
  width     Int?
  height    Int?
  mimeType  String?
  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([confirmedAt])
}

model AffiliateClick {
  id          String             @id @default(cuid())
  productId   String?
  providerId  String?
  articleId   String?
  category    String?
  campaign    String?
  referrer    String?
  deviceType  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  sessionHash String?
  createdAt   DateTime           @default(now())
  article     Article?           @relation(fields: [articleId], references: [id])
  product     Product?           @relation(fields: [productId], references: [id])
  provider    AffiliateProvider? @relation(fields: [providerId], references: [id])

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([providerId, createdAt])
  @@index([articleId, createdAt])
}

model Redirect {
  id          String             @id @default(cuid())
  slug        String             @unique
  productId   String?
  providerId  String?
  destination String
  approved    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  product     Product?           @relation(fields: [productId], references: [id])
  provider    AffiliateProvider? @relation(fields: [providerId], references: [id])

  @@index([approved])
}

model SEOSettings {
  id                 String   @id @default(cuid())
  siteName           String   @default("Venuvella")
  defaultTitle       String?
  defaultDescription String?
  defaultOgImage     String?
  robotsIndex        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationJob {
  id        String    @id @default(cuid())
  name      String    @unique
  enabled   Boolean   @default(true)
  schedule  String?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AutomationLog {
  id         String              @id @default(cuid())
  jobName    String
  status     String
  startedAt  DateTime
  finishedAt DateTime?
  processed  Int                 @default(0)
  failed     Int                 @default(0)
  error      String?
  items      AutomationLogItem[]
  createdAt  DateTime            @default(now())

  @@index([jobName, startedAt])
}

model AutomationLogItem {
  id String @id @default(cuid())

  automationLogId String

  automationLog AutomationLog @relation(fields: [automationLogId], references: [id], onDelete: Cascade)

  providerProductId String?

  providerId   String?
  providerName String?
  providerSlug String?

  productId   String?
  productName String?
  productSlug String?

  externalProductId String?

  status  String
  message String?

  durationMs Int?

  createdAt DateTime @default(now())

  @@index([automationLogId, createdAt])
  @@index([status])
  @@index([providerId])
  @@index([productId])
  @@index([providerProductId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
  ANALYST
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleBlockType {
  HEADING
  PARAGRAPH
  IMAGE
  GALLERY
  QUOTE
  BULLET_LIST
  NUMBERED_LIST
  PRODUCT
  PRODUCT_GRID
  COMPARISON_TABLE
  CTA
  FAQ
  RELATED_ARTICLE
  RELATED_PRODUCTS
  AFFILIATE_DISCLOSURE
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DISCOVERED
  IMPORTED
  PENDING_REVIEW
  PUBLISHED
  SYNCED
  STALE
  UNAVAILABLE
  ARCHIVED
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
  STALE
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  CONFIGURED
}

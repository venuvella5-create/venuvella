DATABASE_URL="postgresql://postgres:password@localhost:5432/venuvella?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-long-random-secret"
# Optional: your Amazon Associates tracking ID, used by `npm run db:seed-launch`
AMAZON_ASSOCIATE_TAG=""

# Image uploads (Supabase Storage). Find both in Supabase: Project Settings > API.
# Keep the service role key secret: never put it in a variable starting with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="venuvella-images"
